  "slides": [
    {
      "title": "Sound you can see",
      "title_html": "Sound you<br>can see<span class=\"dot\">.</span>",
      "layout": "cover",
      "section": "Audio design talk",
      "glow": "ember",
      "subtitle": "How a team turns listening habits into a product people can feel before they read the spec.",
      "backdrop": {
        "image": "media/cinematic/mic-darkness.webp",
        "place": "right",
        "start": 44,
        "fade": 24,
        "focus": "4% 42%",
        "brightness": 1.3,
        "alt": "A vintage microphone lit from above against a black background"
      },
      "body_html": "<div class=\"reveal\" style=\"--delay:300ms\"><p class=\"presenter\">Presenter name</p><p class=\"meta\">Design team · Studio session · 2026</p></div>",
      "source_credit": "Example deck · fictional content",
      "duration_seconds": 40,
      "notes_en": "Open with the question, not the product. This example deck shows the cinematic preset; replace every line with your own content."
    },
    {
      "title": "Three parts. One question.",
      "title_html": "Three parts. One question:<br><em>what should listening feel like?</em>",
      "title_lines": 2,
      "section": "Today",
      "glow": "rust",
      "body_html": "<div class=\"tiles\" style=\"--tile-h:300px\"><div class=\"tile reveal\" style=\"--delay:200ms\"><figure><img src=\"{{asset:media/cinematic/night-train.webp}}\" alt=\"A train passing a dark station platform at night\" style=\"object-position:60% 50%\"></figure><div class=\"tile-text\"><span class=\"num\">01</span><h3>Listen</h3><p>Where and how people really listen.</p></div></div><div class=\"tile reveal\" style=\"--delay:320ms\"><figure><img src=\"{{asset:media/cinematic/studio-mic-red.webp}}\" alt=\"A studio microphone in a recording room\" style=\"object-position:50% 40%\"></figure><div class=\"tile-text\"><span class=\"num\">02</span><h3>Shape</h3><p>Turn what we saw into tuning choices.</p></div></div><div class=\"tile reveal\" style=\"--delay:440ms\"><figure><img src=\"{{asset:media/cinematic/console-blue.webp}}\" alt=\"Faders on a mixing console lit in blue\" style=\"object-position:50% 60%\"></figure><div class=\"tile-text\"><span class=\"num\">03</span><h3>Ship</h3><p>Check the feeling, then the numbers.</p></div></div></div>",
      "duration_seconds": 40,
      "notes_en": "Three parts, one question. Every part ends with a decision.",
      "body_top": 420
    },
    {
      "title": "Listen first",
      "layout": "divider",
      "number_label": "01",
      "section_number": "Part 01",
      "section": "Listen",
      "glow": "plum",
      "subtitle": "Before anyone sketches, watch where and how people actually listen.",
      "backdrop": {
        "image": "media/cinematic/mics-on-stand.webp",
        "place": "right",
        "start": 40,
        "focus": "62% 50%",
        "brightness": 1.15,
        "alt": "Two studio microphones crossing on a stand in the dark"
      },
      "body_html": "<ul class=\"marks reveal\" style=\"--delay:380ms\"><li><span>Where</span>Commutes and shared rooms</li><li><span>When</span>Late at night</li><li><span>With whom</span>Calls and group play</li><li><span>Why</span>Focus and escape</li></ul>",
      "duration_seconds": 30,
      "notes_en": "Section one. The four marks are the situations we look for."
    },
    {
      "title": "Four moments shape a session",
      "title_html": "Four moments<br>shape a session",
      "title_lines": 2,
      "section_number": "01",
      "section": "Field notes",
      "glow": "indigo",
      "slide_class": "narrow",
      "subtitle": "An illustrative pattern from home visits. Replace it with your own observations.",
      "backdrop": {
        "image": "media/cinematic/desk-mics.webp",
        "place": "top-right",
        "start": 50,
        "height": 60,
        "focus": "50% 45%",
        "alt": "Two desktop microphones on a desk lit in blue"
      },
      "body_top": 600,
      "body_html": "<div class=\"cards\"><div class=\"card reveal\" style=\"--delay:240ms\"><span class=\"label\">01 · Arrive</span><h3>Put it on</h3><p>Fit and comfort decide the first ten seconds.</p></div><div class=\"card reveal\" style=\"--delay:340ms\"><span class=\"label\">02 · Tune</span><h3>Find the voice</h3><p>People adjust until speech sounds close and clear.</p></div><div class=\"card reveal\" style=\"--delay:440ms\"><span class=\"label\">03 · Stay</span><h3>Forget it is there</h3><p>Pressure and heat show up after an hour.</p></div><div class=\"card reveal\" style=\"--delay:540ms\"><span class=\"label\">04 · Leave</span><h3>Take it off</h3><p>What they say next is the review they will write.</p></div></div><p class=\"takeaway reveal\" style=\"--delay:700ms\"><strong>So what</strong>Design for the hour of use, not the unboxing.</p>",
      "duration_seconds": 60,
      "notes_en": "Walk the four moments left to right. Say clearly that the pattern is illustrative."
    },
    {
      "title": "From signal to feeling",
      "section_number": "02",
      "section": "Shape",
      "glow": "violet",
      "subtitle": "Every stage can lose what the listener should notice. Design for the whole chain.",
      "body_top": 420,
      "body_html": "<svg class=\"stage-svg reveal\" style=\"--delay:160ms\" viewBox=\"0 0 1712 420\" role=\"img\" aria-label=\"Five stages from source to feeling: source, room, device, ear and feeling\" xmlns=\"http://www.w3.org/2000/svg\">\n<defs><marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto\"><path d=\"M0 0L10 5L0 10z\" style=\"fill:var(--accent)\"/></marker></defs>\n<g fill=\"none\" stroke-width=\"3\" style=\"stroke:var(--accent)\">\n<path class=\"trace\" pathLength=\"1\" style=\"--delay:420ms\" d=\"M249 112H427\" marker-end=\"url(#arrow)\"/>\n<path class=\"trace\" pathLength=\"1\" style=\"--delay:560ms\" d=\"M591 112H769\" marker-end=\"url(#arrow)\"/>\n<path class=\"trace\" pathLength=\"1\" style=\"--delay:700ms\" d=\"M933 112H1111\" marker-end=\"url(#arrow)\"/>\n<path class=\"trace\" pathLength=\"1\" style=\"--delay:840ms\" d=\"M1275 112H1453\" marker-end=\"url(#arrow)\"/>\n</g>\n<g stroke-width=\"2\" style=\"stroke:color-mix(in srgb, var(--accent) 70%, transparent)\">\n<circle cx=\"171\" cy=\"112\" r=\"70\" style=\"fill:#1d1f29\"/><circle cx=\"513\" cy=\"112\" r=\"70\" style=\"fill:#1d1f29\"/><circle cx=\"855\" cy=\"112\" r=\"70\" style=\"fill:#1d1f29\"/><circle cx=\"1197\" cy=\"112\" r=\"70\" style=\"fill:#1d1f29\"/><circle cx=\"1539\" cy=\"112\" r=\"70\" style=\"fill:var(--accent)\"/>\n</g>\n<g font-family=\"Courier Prime, monospace\" font-weight=\"700\" font-size=\"30\" text-anchor=\"middle\" style=\"fill:var(--accent-ink)\">\n<text x=\"171\" y=\"123\">01</text><text x=\"513\" y=\"123\">02</text><text x=\"855\" y=\"123\">03</text><text x=\"1197\" y=\"123\">04</text><text x=\"1539\" y=\"123\" style=\"fill:#140d0a\">05</text>\n</g>\n<g class=\"display-label\" font-family=\"Barlow Condensed, sans-serif\" font-weight=\"700\" font-size=\"50\" text-anchor=\"middle\">\n<text x=\"171\" y=\"252\">Source</text><text x=\"513\" y=\"252\">Room</text><text x=\"855\" y=\"252\">Device</text><text x=\"1197\" y=\"252\">Ear</text><text x=\"1539\" y=\"252\" style=\"fill:var(--accent)\">Feeling</text>\n</g>\n<g font-size=\"24\" text-anchor=\"middle\" style=\"fill:var(--muted)\">\n<text x=\"171\" y=\"298\">What was recorded</text><text x=\"171\" y=\"330\">or rendered</text>\n<text x=\"513\" y=\"298\">Echo, noise and</text><text x=\"513\" y=\"330\">distance</text>\n<text x=\"855\" y=\"298\">Drivers, fit</text><text x=\"855\" y=\"330\">and tuning</text>\n<text x=\"1197\" y=\"298\">Each person hears</text><text x=\"1197\" y=\"330\">a little differently</text>\n<text x=\"1539\" y=\"298\">Clear, close,</text><text x=\"1539\" y=\"330\">easy to judge</text>\n</g>\n</svg><p class=\"takeaway reveal\" style=\"--delay:900ms\"><strong>Rule of thumb</strong>Fix the earliest stage that loses the detail.</p>",
      "duration_seconds": 60,
      "notes_en": "Read the chain left to right. The last circle is the only one the customer sees."
    },
    {
      "title": "What we check before launch",
      "section_number": "03",
      "section": "Ship",
      "theme": "paper",
      "glow": "none",
      "slide_class": "narrow",
      "subtitle": "Example targets for a listening test. Set your own with the team.",
      "body_top": 470,
      "body_html": "<div class=\"stats reveal\" style=\"--delay:200ms;--cols:2;width:1000px;row-gap:56px\"><div class=\"stat\"><b>8/10</b><span>listeners pick the new tuning in a blind A/B</span></div><div class=\"stat\"><b>60 min</b><span>worn before anyone mentions pressure</span></div><div class=\"stat\"><b>2 s</b><span>to hear a voice clearly after switching modes</span></div><div class=\"stat\"><b>0</b><span>unexplained terms in the setup screen</span></div></div><img class=\"multiply reveal\" style=\"--delay:120ms;position:absolute;right:40px;top:-300px;height:820px\" src=\"{{asset:media/cinematic/condenser-mic.webp}}\" alt=\"A large-diaphragm condenser microphone on a white background\">",
      "duration_seconds": 45,
      "notes_en": "These are example targets. Agree on real ones before the test starts.",
      "title_lines": 2,
      "title_html": "What we check<br>before launch"
    },
    {
      "title": "Thank you. Questions?",
      "title_html": "Thank you.<br><em>Questions?</em>",
      "layout": "statement",
      "section": "Takeaways",
      "glow": "steel",
      "backdrop": {
        "image": "media/cinematic/stage-blue.webp",
        "place": "right",
        "focus": "40% 30%",
        "brightness": 1.05,
        "alt": "A band on stage under blue light",
        "start": 30,
        "fade": 30
      },
      "body_html": "<ul class=\"marks reveal\" style=\"--delay:300ms;--cols:3\"><li><span>01</span>Watch real listening<small>Places, times and people.</small></li><li><span>02</span>Design the whole chain<small>Fix the earliest loss.</small></li><li><span>03</span>Test the feeling<small>Then confirm with numbers.</small></li></ul>",
      "duration_seconds": 30,
      "notes_en": "Close on the three takeaways and open the floor."
    }
